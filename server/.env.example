NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=multivendor_platform
DB_NAME_TEST=multivendor_platform_test
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars

# Leave SMTP_USER empty in development: invitation links are printed to the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Used only by `npm run seed`
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe-Now-123

# Reserved for later milestones (payments, uploads)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPLOAD_DIR=private_uploads
